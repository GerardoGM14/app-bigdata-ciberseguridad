# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

NODE_ENV=development
PORT=3000

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/centinela?retryWrites=true&w=majority

# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=2h

# URL pública de la app (se usa en el enlace de recuperación de contraseña)
APP_URL=http://localhost:3000

# Clave que deben enviar los sistemas en la cabecera X-API-Key para la ingesta automática
INGESTA_API_KEY=

# Correo: usar Brevo (recomendado en Render) o SMTP. Si ninguno está configurado,
# los correos se imprimen en la consola del servidor (solo para desarrollo).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Centinela
MAIL_FROM_EMAIL=

# Días que se conservan los eventos antes de expirar automáticamente
RETENCION_EVENTOS_DIAS=365

# Intentos de autenticación permitidos por IP cada 15 minutos
LIMITE_AUTH=20

# Credenciales iniciales que crea "npm run seed" (cámbialas después del primer ingreso)
SEED_ADMIN_EMAIL=admin@cordillera.demo
SEED_ADMIN_PASSWORD=Admin#Centinela2026
SEED_COLAB_EMAIL=colaborador@cordillera.demo
SEED_COLAB_PASSWORD=Colab#Centinela2026
